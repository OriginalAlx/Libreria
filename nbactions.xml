<?xml version="1.0" encoding="UTF-8"?>
<actions>
    <action>
        <actionName>run</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.mainClass>com.libreria.edex.LibreriaEdexApplication</spring-boot.run.mainClass>
            <spring-boot.run.jvmArguments>-Dvaadin.productionMode=false</spring-boot.run.jvmArguments>
        </properties>
    </action>
    <action>
        <actionName>debug</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.mainClass>com.libreria.edex.LibreriaEdexApplication</spring-boot.run.mainClass>
            <spring-boot.run.jvmArguments>-agentlib:jdwp=transport=dt_socket,server=n,address=${jpda.address} -Dvaadin.productionMode=false</spring-boot.run.jvmArguments>
            <jpda.listen>true</jpda.listen>
        </properties>
    </action>
    <action>
        <actionName>profile</actionName>
        <packagings>
            <packaging>jar</packaging>
        </packagings>
        <goals>
            <goal>spring-boot:run</goal>
        </goals>
        <properties>
            <spring-boot.run.mainClass>com.libreria.edex.LibreriaEdexApplication</spring-boot.run.mainClass>
            <spring-boot.run.profiles>dev</spring-boot.run.profiles>
        </properties>
    </action>
</actions>
